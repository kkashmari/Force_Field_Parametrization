# Native LigParGen OPLS-AA validation input
# Force-field parameters and topology come directly from LigParGen/BOSS.

units           real
dimension       3
boundary        p p p
atom_style      full

pair_style      lj/cut/coul/long 12.0
pair_modify     mix geometric
bond_style      harmonic
angle_style     harmonic
dihedral_style  opls
improper_style  cvff
special_bonds   lj/coul 0.0 0.0 0.5
kspace_style    pppm 1.0e-5

read_data       Pegda_Mn_250_ligpargen_opls.data

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes
thermo          1
thermo_style    custom step atoms temp press pe ebond eangle edihed eimp evdwl ecoul
run             0
